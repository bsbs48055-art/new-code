<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'settings.css' | asset_url | stylesheet_tag }}
    {{ 'component-buttons.css' | asset_url | stylesheet_tag }}
    {{ 'component-forms.css' | asset_url | stylesheet_tag }}
    {{ 'template-password.css' | asset_url | stylesheet_tag }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    {{ settings.font_heading | font_face: font_display: 'swap' }}
  </head>
  <body class="template-password">
    <div class="password-page">
      <div class="password-page__inner">
        {% if settings.favicon %}
          <img
            class="password-page__logo"
            src="{{ settings.favicon | image_url: width: 120 }}"
            width="60"
            height="60"
            loading="eager"
            alt="{{ shop.name }}"
          >
        {% endif %}
        <h1 class="password-page__title">{{ shop.name }}</h1>
        <p class="password-page__subtitle">{{ 'general.password_page.opening_soon' | t }}</p>

        {%- form 'storefront_password' -%}
          {%- if form.errors -%}
            <p class="form-message form-message--error" role="alert">
              {{ 'general.password_page.login_form_password_incorrect' | t }}
            </p>
          {%- endif -%}
          <div class="password-page__form-row">
            <label class="visually-hidden" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
            <input
              type="password"
              name="password"
              id="Password"
              class="field__input"
              autocomplete="current-password"
              placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
              required
            >
            <button type="submit" class="button button--primary">
              {{ 'general.password_page.login_form_submit' | t }}
            </button>
          </div>
        {%- endform -%}

        {% if shop.email %}
          <p class="password-page__contact">
            {{ 'general.password_page.contact_admin_html' | t: email: shop.email }}
          </p>
        {% endif %}

        <div class="password-page__social">
          {% render 'social-icons' %}
        </div>
      </div>
    </div>
    <script>document.documentElement.classList.remove('no-js');</script>
  </body>
</html>
