<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="ltr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    {% render 'meta-tags' %}

    <link rel="canonical" href="{{ canonical_url }}">
    {% if settings.favicon %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- unless settings.font_heading.system? -%}
      {{ settings.font_heading | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless -%}
    {%- unless settings.font_body.system? -%}
      {{ settings.font_body | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless -%}

    {{ content_for_header }}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% elsif settings.seo_default_meta_description %}
      <meta name="description" content="{{ settings.seo_default_meta_description | escape }}">
    {% endif %}

    {% render 'structured-data' %}

    <script>
      window.FoodCraft = window.FoodCraft || {};
      window.FoodCraft.moneyFormat = {{ shop.money_format | json }};
      window.FoodCraft.locale = {{ request.locale.iso_code | json }};
      window.FoodCraft.strings = {
        addedToCart: {{ 'products.product.added_to_cart' | t | json }},
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        cartError: {{ 'sections.cart.cart_error' | t | json }},
        wishlistAdded: {{ 'products.product.wishlist_added' | t | json }},
        wishlistRemoved: {{ 'products.product.wishlist_removed' | t | json }},
        compareLimit: {{ 'products.product.compare_limit' | t: count: 4 | json }},
        loading: {{ 'general.accessibility.loading' | t | json }}
      };
      window.FoodCraft.routes = {
        cartAddUrl: {{ routes.cart_add_url | json }},
        cartChangeUrl: {{ routes.cart_change_url | json }},
        cartUpdateUrl: {{ routes.cart_update_url | json }},
        cartUrl: {{ routes.cart_url | json }},
        cartClearUrl: {{ routes.cart_clear_url | json }},
        predictiveSearchUrl: {{ routes.predictive_search_url | json }},
        searchUrl: {{ routes.search_url | json }},
        rootUrl: {{ routes.root_url | json }}
      };
      window.FoodCraft.cart = {
        itemCount: {{ cart.item_count | json }},
        totalPrice: {{ cart.total_price | json }},
        freeShippingThreshold: {{ settings.cart_free_shipping_threshold | times: 100 | json }},
        type: {{ settings.cart_type | json }}
      };
    </script>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'settings.css' | asset_url | stylesheet_tag }}
    {{ 'component-buttons.css' | asset_url | stylesheet_tag }}
    {{ 'component-forms.css' | asset_url | stylesheet_tag }}
    {{ 'component-header.css' | asset_url | stylesheet_tag }}
    {{ 'component-footer.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-card.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-grid.css' | asset_url | stylesheet_tag }}
    {{ 'component-price-swatches.css' | asset_url | stylesheet_tag }}
    {{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
    {{ 'component-modal.css' | asset_url | stylesheet_tag }}
    {{ 'component-slider.css' | asset_url | stylesheet_tag }}
    {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
    {{ 'component-search.css' | asset_url | stylesheet_tag }}
    {{ 'component-recipe.css' | asset_url | stylesheet_tag }}
    {{ 'component-homepage-marketing.css' | asset_url | stylesheet_tag }}
    {{ 'template-product.css' | asset_url | stylesheet_tag }}
    {{ 'component-reviews.css' | asset_url | stylesheet_tag }}
    {{ 'template-collection.css' | asset_url | stylesheet_tag }}
    {{ 'template-blog.css' | asset_url | stylesheet_tag }}
    {{ 'template-page.css' | asset_url | stylesheet_tag }}
    {{ 'component-animations.css' | asset_url | stylesheet_tag }}

    {{ settings.font_body | font_face: font_display: 'swap' }}
    {{ settings.font_heading | font_face: font_display: 'swap' }}

    <script src="{{ 'global.js' | asset_url }}" type="module"></script>
    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>

    {% if settings.enable_animations %}
      <script>document.documentElement.classList.add('animations-enabled');</script>
    {% endif %}

    {% if settings.favicon == blank %}
      <link rel="icon" href="data:,">
    {% endif %}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-to-content-link visually-hidden" href="#MainContent">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {% render 'quick-view-modal' %}
    {% render 'search-drawer' %}

    <div id="PageOverlay" class="page-overlay" data-page-overlay hidden></div>

    <template id="a11y-refresh-page-message">
      <p role="status" aria-live="polite" hidden>{{ 'general.accessibility.refresh_page' | t }}</p>
    </template>

    <script src="{{ 'animations.js' | asset_url }}" type="module"></script>
    <script src="{{ 'header.js' | asset_url }}" type="module"></script>
    <script src="{{ 'cart.js' | asset_url }}" type="module"></script>
    <script src="{{ 'quick-view.js' | asset_url }}" type="module"></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" type="module"></script>
    <script src="{{ 'wishlist.js' | asset_url }}" type="module"></script>
    <script src="{{ 'compare.js' | asset_url }}" type="module"></script>
    <script src="{{ 'recently-viewed.js' | asset_url }}" type="module"></script>
    <script src="{{ 'slider.js' | asset_url }}" type="module"></script>
    <script src="{{ 'product-form.js' | asset_url }}" type="module"></script>
    <script src="{{ 'countdown.js' | asset_url }}" type="module"></script>
    <script src="{{ 'reviews.js' | asset_url }}" type="module"></script>
    <script src="{{ 'facets.js' | asset_url }}" type="module"></script>

    <script>document.documentElement.classList.remove('no-js');</script>
  </body>
</html>
