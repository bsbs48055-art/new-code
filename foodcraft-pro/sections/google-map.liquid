{%- liquid
  assign query = section.settings.address | url_encode
-%}
<section class="section-padding google-map" id="GoogleMap-{{ section.id }}">
  <div class="page-width">
    <div class="google-map__inner rounded card-shadow" data-animate="fade">
      <div class="google-map__frame">
        {%- if section.settings.address != blank -%}
          <iframe
            src="https://www.google.com/maps?q={{ query }}&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="{{ 'sections.google_map.map_title' | t }}"
          ></iframe>
        {%- else -%}
          <div class="google-map__placeholder">
            {% render 'icon', name: 'map-pin' %}
            <p>{{ 'sections.google_map.no_address' | t }}</p>
          </div>
        {%- endif -%}
      </div>

      <div class="google-map__details">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <p class="google-map__detail-item">
            {% render 'icon', name: 'map-pin', class: 'icon--small' %}
            <span>{{ section.settings.address }}</span>
          </p>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <p class="google-map__detail-item">
            {% render 'icon', name: 'phone', class: 'icon--small' %}
            <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
          </p>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <p class="google-map__detail-item">
            {% render 'icon', name: 'clock', class: 'icon--small' %}
            <span>{{ section.settings.hours }}</span>
          </p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="button button--primary">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.google_map.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.google_map.settings.heading.label",
      "default": "Visit Our Flagship Kitchen"
    },
    {
      "type": "text",
      "id": "address",
      "label": "t:sections.google_map.settings.address.label",
      "default": "148 Harvest Lane, Portland, OR 97201"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:sections.google_map.settings.phone.label",
      "default": "+1 (503) 555-0142"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "t:sections.google_map.settings.hours.label",
      "default": "Mon–Sat, 9am–6pm"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.google_map.settings.button_label.label",
      "default": "Get Directions"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.google_map.settings.button_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.google_map.presets.name"
    }
  ]
}
{% endschema %}
