{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign reviews_list = product.metafields.reviews.reviews_list.value
-%}
<section class="section-padding product-reviews bg-secondary" id="Reviews-{{ section.id }}">
  <div class="page-width">
    <div class="product-reviews__header" data-animate="fade">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if rating -%}
        <div class="product-reviews__summary">
          {% render 'star-rating', rating: rating.rating, count: rating_count %}
          <span class="product-reviews__summary-text">{{ 'products.reviews.based_on_count' | t: count: rating_count }}</span>
        </div>
      {%- endif -%}
      <button type="button" class="button button--outline" data-toggle-review-form>
        {{ 'products.reviews.write_a_review' | t }}
      </button>
    </div>

    <div class="product-reviews__form" data-review-form-panel hidden>
      {% render 'review-form', product: product %}
    </div>

    <div class="product-reviews__list">
      {%- if reviews_list.size > 0 -%}
        {%- for review in reviews_list limit: section.settings.reviews_to_show -%}
          {% render 'review-card', review: review %}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {% render block %}
          {%- endif -%}
        {%- endfor -%}
        <p class="product-reviews__empty">{{ 'products.reviews.no_reviews_yet' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.product_reviews.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_reviews.settings.heading.label",
      "default": "Customer Reviews"
    },
    {
      "type": "range",
      "id": "reviews_to_show",
      "min": 3,
      "max": 20,
      "step": 1,
      "label": "t:sections.product_reviews.settings.reviews_to_show.label",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
