<section class="section-padding reservation-section">
  <div class="page-width">
    <div class="reservation-section__grid">
      {%- if section.settings.image != blank -%}
        <div class="reservation-section__media aspect-ratio aspect-ratio--portrait rounded" data-animate="slide-right">
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            srcset="{{ section.settings.image | image_url: width: 450 }} 450w, {{ section.settings.image | image_url: width: 900 }} 900w"
            sizes="(min-width: 750px) 40vw, 90vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}

      <div class="reservation-section__form-wrapper" data-animate="fade">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1>{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="reservation-section__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- form 'contact', class: 'reservation-form', id: 'ReservationForm' -%}
          <input type="hidden" name="contact[tags]" value="reservation">

          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status">
              {{ 'sections.reservation.success' | t }}
            </p>
          {%- else -%}
            {%- if form.errors -%}
              <p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>
            {%- endif -%}

            <div class="form-row form-row--2-col">
              <div class="field">
                <label class="field__label field__label--required" for="ReservationName">{{ 'sections.reservation.name' | t }}</label>
                <input type="text" class="field__input" id="ReservationName" name="contact[name]" required>
              </div>
              <div class="field">
                <label class="field__label field__label--required" for="ReservationPhone">{{ 'sections.reservation.phone' | t }}</label>
                <input type="tel" class="field__input" id="ReservationPhone" name="contact[phone]" required>
              </div>
            </div>

            <div class="field">
              <label class="field__label field__label--required" for="ReservationEmail">{{ 'sections.reservation.email' | t }}</label>
              <input type="email" class="field__input" id="ReservationEmail" name="contact[email]" required>
            </div>

            <div class="form-row form-row--2-col">
              <div class="field">
                <label class="field__label field__label--required" for="ReservationDate">{{ 'sections.reservation.date' | t }}</label>
                <input type="date" class="field__input" id="ReservationDate" name="contact[Reservation date]" data-reservation-date required>
              </div>
              <div class="field">
                <label class="field__label field__label--required" for="ReservationTime">{{ 'sections.reservation.time' | t }}</label>
                <select class="field__input" id="ReservationTime" name="contact[Reservation time]" required>
                  <option value="">{{ 'sections.reservation.select_time' | t }}</option>
                  {%- for hour in (11..20) -%}
                    <option value="{{ hour }}:00">{{ hour }}:00</option>
                    <option value="{{ hour }}:30">{{ hour }}:30</option>
                  {%- endfor -%}
                </select>
              </div>
            </div>

            <div class="field">
              <label class="field__label field__label--required" for="ReservationPartySize">{{ 'sections.reservation.party_size' | t }}</label>
              <select class="field__input" id="ReservationPartySize" name="contact[Party size]" required>
                {%- for i in (1..12) -%}
                  <option value="{{ i }}">{{ 'sections.reservation.guests' | t: count: i }}</option>
                {%- endfor -%}
              </select>
            </div>

            <div class="field">
              <label class="field__label" for="ReservationNotes">{{ 'sections.reservation.notes' | t }}</label>
              <textarea class="field__textarea" id="ReservationNotes" name="contact[body]" rows="4" placeholder="{{ 'sections.reservation.notes_placeholder' | t }}"></textarea>
            </div>

            <button type="submit" class="button button--primary button--full button--large">
              {{ 'sections.reservation.submit' | t }}
            </button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.reservation.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.reservation.settings.image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.reservation.settings.eyebrow.label",
      "default": "Dine With Us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.reservation.settings.heading.label",
      "default": "Reserve a Table"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.reservation.settings.text.label",
      "default": "<p>Join us for a seasonal tasting menu at our flagship kitchen. Reservations are recommended, especially on weekends.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:sections.reservation.presets.name"
    }
  ]
}
{% endschema %}
