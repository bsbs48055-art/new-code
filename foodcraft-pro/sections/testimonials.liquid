<section class="section-padding testimonials" id="Testimonials-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading" data-animate="fade">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <slider-component data-autoplay="{{ section.settings.autoplay_speed }}">
      <div class="slider__track testimonials__track" data-slider-track style="--slider-gap: 2.4rem;" role="list">
        {%- for block in section.blocks -%}
          <div class="testimonial-card" role="listitem" data-animate="fade" data-animate-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {% render 'icon', name: 'quote', class: 'testimonial-card__quote-icon' %}
            {%- if block.settings.rating > 0 -%}
              {% render 'star-rating', rating: block.settings.rating, show_count: false %}
            {%- endif -%}
            <p class="testimonial-card__text">&ldquo;{{ block.settings.text }}&rdquo;</p>
            <div class="testimonial-card__author">
              {%- if block.settings.avatar != blank -%}
                <img
                  class="testimonial-card__avatar"
                  src="{{ block.settings.avatar | image_url: width: 100 }}"
                  alt="{{ block.settings.name | escape }}"
                  width="48"
                  height="48"
                  loading="lazy"
                >
              {%- endif -%}
              <div>
                <p class="testimonial-card__name">{{ block.settings.name }}</p>
                {%- if block.settings.location != blank -%}
                  <p class="testimonial-card__location">{{ block.settings.location }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="slider__dots" data-slider-dots></div>
      {%- endif -%}
    </slider-component>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.testimonials.settings.eyebrow.label",
      "default": "Loved By Home Cooks"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.testimonials.settings.heading.label",
      "default": "What Our Customers Say"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "t:sections.testimonials.settings.autoplay_speed.label",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "t:sections.testimonials.blocks.testimonial.settings.rating.label",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.testimonials.blocks.testimonial.settings.text.label",
          "default": "The chili crunch changed my weeknight dinners forever. Every product tastes like it was made by someone who actually cares."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "t:sections.testimonials.blocks.testimonial.settings.avatar.label"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.testimonials.blocks.testimonial.settings.name.label",
          "default": "Jordan M."
        },
        {
          "type": "text",
          "id": "location",
          "label": "t:sections.testimonials.blocks.testimonial.settings.location.label",
          "default": "Austin, TX"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.presets.name",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
