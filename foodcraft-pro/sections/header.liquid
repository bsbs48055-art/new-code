{%- liquid
  assign menu = linklists[section.settings.menu]
-%}
<sticky-header
  class="header-wrapper{% if section.settings.sticky_header %} header-wrapper--sticky{% endif %}{% if section.settings.transparent_on_home and request.page_type == 'index' %} header-wrapper--transparent{% endif %}"
  data-sticky="{{ section.settings.sticky_header }}"
>
  <header class="header header--{{ section.settings.header_layout }}">
    <div class="page-width header__inner">
      <div class="header__mobile-toggle">
        <button type="button" class="header__icon-button" data-mobile-nav-toggle aria-label="{{ 'general.accessibility.menu' | t }}" aria-expanded="false" aria-controls="MobileNav">
          {% render 'icon', name: 'menu' %}
        </button>
      </div>

      <div class="header__logo">
        <a href="{{ routes.root_url }}" class="header__logo-link">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: 400 }}"
              srcset="{{ section.settings.logo | image_url: width: 200 }} 200w, {{ section.settings.logo | image_url: width: 400 }} 400w"
              sizes="{{ section.settings.logo_width }}px"
              width="{{ section.settings.logo_width }}"
              height="{{ section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | default: 40 }}"
              alt="{{ shop.name }}"
              loading="eager"
              style="width: {{ section.settings.logo_width }}px;"
            >
          {%- else -%}
            <span class="header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <nav class="header__nav" aria-label="{{ 'general.accessibility.main_navigation' | t }}">
        <ul class="header__menu">
          {%- for link in menu.links -%}
            <li>
              {% render 'mega-menu', link: link, section: section %}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="header__icons">
        {%- if section.settings.show_search -%}
          <button type="button" class="header__icon-button" data-search-toggle aria-label="{{ 'general.search.search' | t }}">
            {% render 'icon', name: 'search' %}
          </button>
        {%- endif -%}

        {%- if section.settings.show_account -%}
          <a href="{{ routes.account_url }}" class="header__icon-button" aria-label="{{ 'general.accessibility.account' | t }}">
            {% render 'icon', name: 'user' %}
          </a>
        {%- endif -%}

        {%- if section.settings.show_wishlist -%}
          <a href="/pages/wishlist" class="header__icon-button" data-wishlist-count-wrapper aria-label="{{ 'general.wishlist.title' | t }}">
            {% render 'icon', name: 'heart' %}
            <span class="header__cart-count is-hidden" data-wishlist-count>0</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_compare -%}
          <a href="/pages/compare" class="header__icon-button" data-compare-count-wrapper aria-label="{{ 'general.compare.title' | t }}">
            {% render 'icon', name: 'compare' %}
            <span class="header__cart-count is-hidden" data-compare-count>0</span>
          </a>
        {%- endif -%}

        {% render 'cart-icon-bag' %}
      </div>
    </div>
  </header>
</sticky-header>

{% render 'mobile-nav', menu: menu %}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 260,
      "step": 5,
      "unit": "px",
      "label": "t:sections.header.settings.logo_width.label",
      "default": 140
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "t:sections.header.settings.header_layout.label",
      "options": [
        { "value": "logo-left", "label": "t:sections.header.settings.header_layout.options.logo_left" },
        { "value": "logo-center", "label": "t:sections.header.settings.header_layout.options.logo_center" }
      ],
      "default": "logo-left"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "t:sections.header.settings.sticky_header.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "transparent_on_home",
      "label": "t:sections.header.settings.transparent_on_home.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.header.settings.show_search.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:sections.header.settings.show_account.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "t:sections.header.settings.show_wishlist.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "t:sections.header.settings.show_compare.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu_promotion",
      "name": "t:sections.header.blocks.menu_promotion.name",
      "settings": [
        {
          "type": "text",
          "id": "menu_handle_match",
          "label": "t:sections.header.blocks.menu_promotion.settings.menu_handle_match.label",
          "info": "t:sections.header.blocks.menu_promotion.settings.menu_handle_match.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.header.blocks.menu_promotion.settings.image.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.header.blocks.menu_promotion.settings.heading.label",
          "default": "Chef's Pick"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:sections.header.blocks.menu_promotion.settings.subheading.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.header.blocks.menu_promotion.settings.link.label"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.header.blocks.menu_promotion.settings.link_label.label",
          "default": "Shop now"
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
