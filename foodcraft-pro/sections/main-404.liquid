<section class="section-padding error-404">
  <div class="page-width container-narrow text-center">
    {% render 'icon', name: 'chef-hat', class: 'error-404__icon' %}
    <h1>{{ 'general.404.title' | t }}</h1>
    <p class="error-404__text">{{ 'general.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="button button--primary">{{ 'general.404.link' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "settings": []
}
{% endschema %}
