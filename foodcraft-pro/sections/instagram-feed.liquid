<section class="section-padding instagram-feed" id="InstagramFeed-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading" data-animate="fade">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.handle != blank -%}
        <a href="{{ settings.social_instagram_link }}" class="link" target="_blank" rel="noopener">{{ section.settings.handle }}</a>
      {%- endif -%}
    </div>

    <div class="instagram-feed__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' -%}
          <a
            href="{{ block.settings.link | default: settings.social_instagram_link }}"
            class="instagram-feed__item aspect-ratio aspect-ratio--square"
            target="_blank"
            rel="noopener"
            data-animate="fade"
            data-animate-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 400 }}"
                srcset="{{ block.settings.image | image_url: width: 200 }} 200w, {{ block.settings.image | image_url: width: 400 }} 400w"
                sizes="(min-width: 990px) 16vw, 33vw"
                alt="{{ block.settings.image.alt | default: 'Instagram post' | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'lifestyle-3' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="instagram-feed__overlay">{% render 'icon', name: 'instagram' %}</span>
          </a>
        {%- elsif block.type == '@app' -%}
          {% render block %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.instagram_feed.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.instagram_feed.settings.eyebrow.label",
      "default": "Follow Along"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.instagram_feed.settings.heading.label",
      "default": "Tag Us in Your Kitchen Wins"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "t:sections.instagram_feed.settings.handle.label",
      "default": "@foodcraftpro"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.instagram_feed.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.instagram_feed.blocks.image.settings.image.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.instagram_feed.blocks.image.settings.link.label"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.instagram_feed.presets.name",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
