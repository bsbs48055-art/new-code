{%- if section.blocks.size > 0 -%}
  <div class="announcement-bar" style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};" {% if section.settings.enable_carousel and section.blocks.size > 1 %}data-autoplay="{{ section.settings.autoplay_speed }}"{% endif %}>
    <slider-component class="announcement-bar__slider">
      <div class="announcement-bar__track page-width" data-slider-track role="list">
        {%- for block in section.blocks -%}
          <div class="announcement-bar__item" role="listitem" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <button type="button" class="announcement-bar__nav announcement-bar__nav--prev" data-slider-prev aria-label="{{ 'general.slider.previous' | t }}">
          {% render 'icon', name: 'chevron-left' %}
        </button>
        <button type="button" class="announcement-bar__nav announcement-bar__nav--next" data-slider-next aria-label="{{ 'general.slider.next' | t }}">
          {% render 'icon', name: 'chevron-right' %}
        </button>
      {%- endif -%}
    </slider-component>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.announcement_bar.settings.background_color.label",
      "default": "#26201B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.announcement_bar.settings.text_color.label",
      "default": "#FFFDF9"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "t:sections.announcement_bar.settings.enable_carousel.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement_bar.settings.autoplay_speed.label",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement_bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.announcement_bar.blocks.announcement.settings.text.label",
          "default": "Free shipping on orders over $75"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement_bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.presets.name",
      "blocks": [
        { "type": "announcement" },
        { "type": "announcement" }
      ]
    }
  ]
}
{% endschema %}
