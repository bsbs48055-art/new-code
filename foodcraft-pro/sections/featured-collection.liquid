{%- liquid
  assign featured_collection = collections[section.settings.collection]
  assign products_to_show = featured_collection.products | default: blank
-%}
<section class="section-padding featured-collection" id="FeaturedCollection-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading{% unless section.settings.center_heading %} section-heading--left{% endunless %}" data-animate="fade">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if featured_collection != blank and featured_collection.products.size > 0 -%}
      {%- if section.settings.layout == 'carousel' -%}
        <slider-component>
          <div class="slider__track featured-collection__track" data-slider-track style="--slider-gap: 2.4rem;" role="list">
            {%- for product in products_to_show limit: section.settings.products_to_show -%}
              <div class="featured-collection__slide" role="listitem" data-animate="fade" data-animate-index="{{ forloop.index0 }}">
                {% render 'product-card', product: product %}
              </div>
            {%- endfor -%}
          </div>
          <div class="page-width">
            <div class="slider__dots" data-slider-dots></div>
          </div>
        </slider-component>
        <div class="featured-collection__nav">
          <button type="button" class="slider__nav slider__nav--prev" data-slider-prev aria-label="{{ 'general.slider.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
          <button type="button" class="slider__nav slider__nav--next" data-slider-next aria-label="{{ 'general.slider.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
        </div>
      {%- else -%}
        <div class="grid grid--{{ section.settings.columns_desktop }}-col grid--mobile-1-col">
          {%- for product in products_to_show limit: section.settings.products_to_show -%}
            <div data-animate="fade" data-animate-index="{{ forloop.index0 }}">
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="grid grid--{{ section.settings.columns_desktop }}-col grid--mobile-1-col">
        {%- for i in (1..4) -%}
          <div class="product-card">
            <div class="product-card__media-wrapper aspect-ratio aspect-ratio--{{ settings.product_card_image_ratio }} rounded">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="price"><span class="price__regular">{{ 1900 | money }}</span></div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_view_all and featured_collection != blank -%}
      <div class="featured-collection__footer text-center">
        <a href="{{ featured_collection.url }}" class="button button--outline">{{ section.settings.view_all_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.featured_collection.settings.eyebrow.label",
      "default": "Customer Favorites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_collection.settings.heading.label",
      "default": "Featured Products"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.featured_collection.settings.subheading.label",
      "default": "Small-batch pantry staples our community keeps coming back for."
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "t:sections.featured_collection.settings.center_heading.label",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured_collection.settings.layout.label",
      "options": [
        { "value": "grid", "label": "t:sections.featured_collection.settings.layout.options.grid" },
        { "value": "carousel", "label": "t:sections.featured_collection.settings.layout.options.carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:sections.featured_collection.settings.products_to_show.label",
      "default": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.featured_collection.settings.columns_desktop.label",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:sections.featured_collection.settings.view_all_label.label",
      "default": "View All Products"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.presets.name"
    }
  ]
}
{% endschema %}
