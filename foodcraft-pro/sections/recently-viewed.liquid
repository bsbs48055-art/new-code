<section class="section-padding recently-viewed" id="RecentlyViewed-{{ section.id }}" hidden>
  <div class="page-width">
    <div class="section-heading" data-animate="fade">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <slider-component>
      <div
        class="slider__track recently-viewed__track"
        data-slider-track
        data-recently-viewed
        data-exclude-id="{{ product.id }}"
        data-limit="{{ section.settings.products_to_show }}"
        style="--slider-gap: 1.6rem;"
        role="list"
      ></div>
      <div class="slider__dots" data-slider-dots></div>
    </slider-component>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.recently_viewed.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.recently_viewed.settings.heading.label",
      "default": "Recently Viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:sections.recently_viewed.settings.products_to_show.label",
      "default": 8
    }
  ]
}
{% endschema %}
