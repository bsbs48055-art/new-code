<section class="section-padding multicolumn">
  <div class="page-width">
    <div class="section-heading" data-animate="fade">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="grid grid--{{ section.settings.columns_desktop }}-col grid--mobile-1-col">
      {%- for block in section.blocks -%}
        <div class="multicolumn__item" data-animate="fade" data-animate-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="multicolumn__media aspect-ratio aspect-ratio--square rounded">
              <img
                src="{{ block.settings.image | image_url: width: 400 }}"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <div class="multicolumn__icon">
              {% render 'icon', name: block.settings.icon %}
            </div>
          {%- endif -%}
          <h3 class="multicolumn__title">{{ block.settings.heading }}</h3>
          {%- if block.settings.text != blank -%}
            <div class="multicolumn__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.multicolumn.settings.eyebrow.label",
      "default": "Why FoodCraft Pro"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.multicolumn.settings.heading.label",
      "default": "Our Promise"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.multicolumn.settings.columns_desktop.label",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.multicolumn.blocks.column.settings.icon.label",
          "options": [
            { "value": "none", "label": "t:sections.multicolumn.blocks.column.settings.icon.options.none" },
            { "value": "leaf", "label": "t:sections.multicolumn.blocks.column.settings.icon.options.leaf" },
            { "value": "truck", "label": "t:sections.multicolumn.blocks.column.settings.icon.options.truck" },
            { "value": "shield", "label": "t:sections.multicolumn.blocks.column.settings.icon.options.shield" },
            { "value": "chef-hat", "label": "t:sections.multicolumn.blocks.column.settings.icon.options.chef_hat" },
            { "value": "sparkle", "label": "t:sections.multicolumn.blocks.column.settings.icon.options.sparkle" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.multicolumn.blocks.column.settings.heading.label",
          "default": "Sustainably Sourced"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label",
          "default": "<p>We partner with growers who share our commitment to regenerative farming.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.presets.name",
      "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }]
    }
  ]
}
{% endschema %}
