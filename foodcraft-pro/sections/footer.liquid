<footer class="footer bg-dark">
  <div class="page-width footer__inner section-padding">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              <a href="{{ routes.root_url }}" class="footer__logo-link">
                {%- if block.settings.logo != blank -%}
                  <img
                    src="{{ block.settings.logo | image_url: width: 320 }}"
                    alt="{{ shop.name }}"
                    width="{{ block.settings.logo_width }}"
                    height="{{ block.settings.logo_width | divided_by: block.settings.logo.aspect_ratio | default: 40 }}"
                    loading="lazy"
                    style="width: {{ block.settings.logo_width }}px;"
                  >
                {%- else -%}
                  <span class="footer__logo-text">{{ shop.name }}</span>
                {%- endif -%}
              </a>
              {%- if block.settings.description != blank -%}
                <div class="footer__description">{{ block.settings.description }}</div>
              {%- endif -%}
              {% render 'social-icons', class: 'social-icons--footer' %}

            {%- when 'link_list' -%}
              {%- assign footer_menu = linklists[block.settings.menu] -%}
              <h3 class="footer__heading">{{ block.settings.heading }}</h3>
              <ul class="footer__list">
                {%- for link in footer_menu.links -%}
                  <li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>

            {%- when 'contact_info' -%}
              <h3 class="footer__heading">{{ block.settings.heading }}</h3>
              <ul class="footer__contact-list">
                {%- if block.settings.address != blank -%}
                  <li class="footer__contact-item">
                    {% render 'icon', name: 'map-pin', class: 'icon--small' %}
                    <span>{{ block.settings.address }}</span>
                  </li>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <li class="footer__contact-item">
                    {% render 'icon', name: 'phone', class: 'icon--small' %}
                    <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a>
                  </li>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <li class="footer__contact-item">
                    {% render 'icon', name: 'mail', class: 'icon--small' %}
                    <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                  </li>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <li class="footer__contact-item">
                    {% render 'icon', name: 'clock', class: 'icon--small' %}
                    <span>{{ block.settings.hours }}</span>
                  </li>
                {%- endif -%}
              </ul>

            {%- when 'text' -%}
              <h3 class="footer__heading">{{ block.settings.heading }}</h3>
              <div class="footer__text">{{ block.settings.text }}</div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'sections.footer.rights_reserved' | t }}
      </p>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payment-icons">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <ul class="footer__legal-links">
        {%- for link in linklists.footer.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <back-to-top class="back-to-top">
    <button type="button" class="back-to-top__button" aria-label="{{ 'general.accessibility.back_to_top' | t }}">
      {% render 'icon', name: 'chevron-up' %}
    </button>
  </back-to-top>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.footer.blocks.brand.settings.logo.label"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 60,
          "max": 240,
          "step": 5,
          "unit": "px",
          "label": "t:sections.footer.blocks.brand.settings.logo_width.label",
          "default": 140
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:sections.footer.blocks.brand.settings.description.label",
          "default": "<p>Small-batch pantry staples and chef-tested recipes, crafted with sustainably-sourced ingredients.</p>"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "contact_info",
      "name": "t:sections.footer.blocks.contact_info.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.contact_info.settings.heading.label",
          "default": "Visit Us"
        },
        {
          "type": "text",
          "id": "address",
          "label": "t:sections.footer.blocks.contact_info.settings.address.label",
          "default": "148 Harvest Lane, Portland, OR 97201"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "t:sections.footer.blocks.contact_info.settings.phone.label",
          "default": "+1 (503) 555-0142"
        },
        {
          "type": "text",
          "id": "email",
          "label": "t:sections.footer.blocks.contact_info.settings.email.label",
          "default": "hello@foodcraftpro.com"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "t:sections.footer.blocks.contact_info.settings.hours.label",
          "default": "Mon–Sat, 9am–6pm"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label",
          "default": "About"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.text.settings.text.label"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "brand" },
      {
        "type": "link_list",
        "settings": { "heading": "Shop", "menu": "main-menu" }
      },
      {
        "type": "link_list",
        "settings": { "heading": "Company", "menu": "footer" }
      },
      { "type": "contact_info" }
    ]
  }
}
{% endschema %}
