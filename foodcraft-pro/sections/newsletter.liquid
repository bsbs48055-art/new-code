<section
  class="section-padding newsletter"
  id="Newsletter-{{ section.id }}"
  style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
>
  <div class="page-width">
    <div class="newsletter__inner" data-animate="zoom">
      {%- if section.settings.image != blank -%}
        <div class="newsletter__media aspect-ratio aspect-ratio--square rounded">
          <img
            src="{{ section.settings.image | image_url: width: 600 }}"
            srcset="{{ section.settings.image | image_url: width: 300 }} 300w, {{ section.settings.image | image_url: width: 600 }} 600w"
            sizes="(min-width: 750px) 40vw, 90vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}
      <div class="newsletter__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="newsletter__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter__form-row">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'sections.newsletter.email_label' | t }}</label>
            <input
              type="email"
              name="contact[email]"
              id="NewsletterEmail-{{ section.id }}"
              class="field__input newsletter__input"
              placeholder="{{ 'sections.newsletter.email_placeholder' | t }}"
              required
              autocomplete="email"
            >
            <button type="submit" class="button button--primary newsletter__submit">
              {{ 'sections.newsletter.submit' | t }}
            </button>
          </div>

          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status" data-newsletter-success>
              {{ 'sections.newsletter.success' | t }}
            </p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="form-message form-message--error" role="alert">
              {{ form.errors.messages.email | default: 'sections.newsletter.error' | t }}
            </p>
          {%- endif -%}
        {%- endform -%}
        <p class="newsletter__disclaimer">{{ 'sections.newsletter.disclaimer' | t }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.newsletter.settings.background_color.label",
      "default": "#2E6B45"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.newsletter.settings.text_color.label",
      "default": "#FFFDF9"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.newsletter.settings.image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.newsletter.settings.eyebrow.label",
      "default": "Join the Table"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "Get 10% Off Your First Order"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.newsletter.settings.subheading.label",
      "default": "Subscribe for new recipes, seasonal releases, and members-only offers."
    }
  ]
}
{% endschema %}
