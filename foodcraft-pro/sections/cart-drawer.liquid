{%- comment -%}
  Slide-in ajax cart drawer. Content is re-rendered client-side by cart.js
  after every add/update/remove request, using the same markup structure.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.cart_free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  if remaining < 0
    assign remaining = 0
  endif
  assign progress = 100
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
  endif
  if progress > 100
    assign progress = 100
  endif
-%}
<cart-drawer id="CartDrawer" class="cart-drawer" aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-drawer-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.cart.title' | t }}">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">{{ 'sections.cart.title' | t }} ({{ cart.item_count }})</h2>
      <button type="button" class="button--icon" data-cart-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    {%- if settings.cart_show_free_shipping_bar -%}
      <div class="cart-drawer__shipping-bar" data-cart-shipping-bar>
        {%- if remaining > 0 -%}
          <p class="cart-drawer__shipping-message">
            {{ 'sections.cart.free_shipping_remaining_html' | t: amount: remaining | money }}
          </p>
        {%- else -%}
          <p class="cart-drawer__shipping-message cart-drawer__shipping-message--success">
            {% render 'icon', name: 'truck', class: 'icon--small' %}
            {{ 'sections.cart.free_shipping_achieved' | t }}
          </p>
        {%- endif -%}
        <div class="cart-drawer__progress">
          <div class="cart-drawer__progress-bar" style="width: {{ progress }}%;"></div>
        </div>
      </div>
    {%- endif -%}

    <div class="cart-drawer__body" data-cart-drawer-body>
      {%- if cart.item_count == 0 -%}
        <div class="cart-drawer__empty">
          {% render 'icon', name: 'cart', class: 'cart-drawer__empty-icon' %}
          <p>{{ 'sections.cart.empty' | t }}</p>
          <button type="button" class="button button--primary" data-cart-drawer-close>{{ 'sections.cart.continue_shopping' | t }}</button>
        </div>
      {%- else -%}
        <table class="cart-drawer__items">
          <tbody data-cart-items>
            {%- for item in cart.items -%}
              {% render 'cart-item', item: item, context: 'drawer' %}
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-drawer__recommendations" data-cart-recommendations hidden></div>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__footer">
        {%- if settings.cart_show_note -%}
          <details class="cart-drawer__note-toggle">
            <summary>{{ 'sections.cart.add_note' | t }}</summary>
            <textarea class="field__textarea" name="note" data-cart-note placeholder="{{ 'sections.cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
          </details>
        {%- endif -%}

        <div class="cart-drawer__subtotal">
          <span>{{ 'sections.cart.subtotal' | t }}</span>
          <span data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__tax-note">{{ 'sections.cart.taxes_shipping_note' | t }}</p>

        <a href="{{ routes.cart_url }}" class="button button--secondary button--full">{{ 'sections.cart.view_cart' | t }}</a>
        <a href="{{ routes.cart_url }}/checkout" class="button button--primary button--full" data-cart-checkout>{{ 'sections.cart.checkout' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "settings": []
}
{% endschema %}
