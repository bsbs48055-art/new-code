{%- liquid
  assign recipe_blog = blogs[section.settings.blog]
-%}
<section class="section-padding featured-recipes bg-secondary" id="FeaturedRecipes-{{ section.id }}">
  <div class="page-width">
    <div class="section-heading{% unless section.settings.center_heading %} section-heading--left{% endunless %}" data-animate="fade">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if recipe_blog != blank and recipe_blog.articles.size > 0 -%}
      <div class="grid grid--{{ section.settings.columns_desktop }}-col grid--mobile-1-col">
        {%- for article in recipe_blog.articles limit: section.settings.recipes_to_show -%}
          <div data-animate="fade" data-animate-index="{{ forloop.index0 }}">
            {% render 'recipe-card', article: article %}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="grid grid--{{ section.settings.columns_desktop }}-col grid--mobile-1-col">
        {%- for i in (1..3) -%}
          <div class="recipe-card">
            <div class="recipe-card__media aspect-ratio aspect-ratio--portrait rounded">
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="recipe-card__info">
              <h3 class="recipe-card__title">{{ 'onboarding.blog_title' | t }}</h3>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_view_all and recipe_blog != blank -%}
      <div class="featured-collection__footer text-center">
        <a href="{{ recipe_blog.url }}" class="button button--outline">{{ section.settings.view_all_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_recipes.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.featured_recipes.settings.eyebrow.label",
      "default": "From the Recipe Box"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_recipes.settings.heading.label",
      "default": "Featured Recipes"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.featured_recipes.settings.subheading.label",
      "default": "Chef-tested ideas to help you get the most out of every jar."
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "t:sections.featured_recipes.settings.center_heading.label",
      "default": true
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.featured_recipes.settings.blog.label"
    },
    {
      "type": "range",
      "id": "recipes_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:sections.featured_recipes.settings.recipes_to_show.label",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.featured_recipes.settings.columns_desktop.label",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_recipes.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:sections.featured_recipes.settings.view_all_label.label",
      "default": "View All Recipes"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_recipes.presets.name"
    }
  ]
}
{% endschema %}
