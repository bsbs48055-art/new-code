<section class="section-padding main-page">
  <div class="page-width container-narrow">
    {% render 'breadcrumbs' %}
    <h1 class="main-page__title">{{ page.title }}</h1>
    <div class="main-page__content rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_page.name",
  "settings": []
}
{% endschema %}
