<section class="section-padding faq-section">
  <div class="page-width container-narrow">
    <div class="section-heading" data-animate="fade">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.enable_search -%}
      <div class="faq-search">
        <label class="visually-hidden" for="FaqSearch">{{ 'sections.faq.search_label' | t }}</label>
        {% render 'icon', name: 'search' %}
        <input type="search" id="FaqSearch" class="faq-search__input" placeholder="{{ 'sections.faq.search_placeholder' | t }}" data-faq-search>
      </div>
    {%- endif -%}

    <div class="accordion" data-faq-list>
      {%- for block in section.blocks -%}
        <accordion-disclosure>
          <details class="accordion__item" {% if forloop.first %}open{% endif %} data-faq-item {{ block.shopify_attributes }}>
            <summary class="accordion__summary">
              <span data-faq-question>{{ block.settings.question }}</span>
              {% render 'icon', name: 'chevron-down', class: 'icon--chevron' %}
            </summary>
            <div class="accordion__content rte" data-faq-answer>{{ block.settings.answer }}</div>
          </details>
        </accordion-disclosure>
      {%- endfor -%}
      <p class="faq-search__no-results" data-faq-no-results hidden>{{ 'sections.faq.no_results' | t }}</p>
    </div>

    {%- if section.settings.show_contact_cta -%}
      <div class="faq-section__cta" data-animate="fade">
        <p>{{ section.settings.contact_cta_text }}</p>
        <a href="{{ section.settings.contact_cta_link | default: '/pages/contact' }}" class="button button--outline">
          {{ section.settings.contact_cta_button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.faq.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.faq.settings.eyebrow.label",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.faq.settings.heading.label",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.faq.settings.subheading.label"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "t:sections.faq.settings.enable_search.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_contact_cta",
      "label": "t:sections.faq.settings.show_contact_cta.label",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_cta_text",
      "label": "t:sections.faq.settings.contact_cta_text.label",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "contact_cta_button_label",
      "label": "t:sections.faq.settings.contact_cta_button_label.label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_cta_link",
      "label": "t:sections.faq.settings.contact_cta_link.label"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq.blocks.question.settings.question.label",
          "default": "How long does shipping take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq.blocks.question.settings.answer.label",
          "default": "<p>Orders ship within 1-2 business days and arrive within 3-7 business days depending on your location.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.presets.name",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
