[
  {
    "name": "theme_info",
    "theme_name": "FoodCraft Pro",
    "theme_version": "1.0.0",
    "theme_author": "FoodCraft Studio",
    "theme_documentation_url": "https://foodcraft-pro.dev/docs",
    "theme_support_url": "https://foodcraft-pro.dev/support"
  },
  {
    "name": "t:settings_schema.global.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.global.settings.header.content"
      },
      {
        "type": "select",
        "id": "page_width",
        "label": "t:settings_schema.global.settings.page_width.label",
        "options": [
          { "value": "1400", "label": "t:settings_schema.global.settings.page_width.options.narrow" },
          { "value": "1600", "label": "t:settings_schema.global.settings.page_width.options.medium" },
          { "value": "1800", "label": "t:settings_schema.global.settings.page_width.options.wide" }
        ],
        "default": "1600"
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "t:settings_schema.global.settings.corner_radius.label",
        "default": 12
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:settings_schema.global.settings.spacing_sections.label",
        "default": 64
      },
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "t:settings_schema.global.settings.enable_animations.label",
        "default": true
      }
    ]
  },
