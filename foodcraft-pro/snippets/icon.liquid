{%- comment -%}
  Renders an inline SVG icon from the theme's icon set.
  Accepts:
    name: {String} required — icon identifier, see case statement below
    class: {String} optional — additional CSS classes
  Usage:
    {% render 'icon', name: 'cart' %}
    {% render 'icon', name: 'star-filled', class: 'icon--small' %}
{%- endcomment -%}
{%- liquid
  assign icon_class = 'icon icon--' | append: name
  if class
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}
<svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
