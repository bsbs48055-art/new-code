{%- comment -%}
  Open Graph, Twitter Card and general SEO meta tags.
  Rendered once from layout/theme.liquid.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title
  assign og_description = page_description | default: settings.seo_default_meta_description
  assign og_image = settings.seo_default_social_image

  if template contains 'product' and product
    assign og_title = product.title
    assign og_description = product.description | strip_html | truncatewords: 40
    if product.featured_media
      assign og_image = product.featured_media.preview_image
    endif
  elsif template contains 'collection' and collection
    assign og_title = collection.title
    assign og_description = collection.description | strip_html | truncatewords: 40
    if collection.image
      assign og_image = collection.image
    endif
  elsif template contains 'article' and article
    assign og_title = article.title
    assign og_description = article.excerpt_or_content | strip_html | truncatewords: 40
    if article.image
      assign og_image = article.image
    endif
  elsif template contains 'page' and page
    assign og_description = page.content | strip_html | truncatewords: 40
  endif

  assign og_title = og_title | default: shop.name
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
{%- if og_description != blank -%}
  <meta property="og:description" content="{{ og_description | escape }}">
{%- endif -%}
<meta property="og:type" content="{% if template contains 'product' %}product{% elsif template contains 'article' %}article{% else %}website{% endif %}">
{%- if og_image != blank -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | default: 630 }}">
{%- endif -%}
<meta property="og:locale" content="{{ request.locale.iso_code }}">

<meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}">
{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: '/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:title" content="{{ og_title | escape }}">
{%- if og_description != blank -%}
  <meta name="twitter:description" content="{{ og_description | escape }}">
{%- endif -%}
{%- if og_image != blank -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}
