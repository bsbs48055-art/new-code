{%- comment -%}
  Predictive search overlay triggered from the header search icon.
{%- endcomment -%}
<predictive-search id="SearchDrawer" class="search-drawer" aria-hidden="true">
  <div class="search-drawer__overlay" data-search-close></div>
  <div class="search-drawer__panel" role="search">
    <div class="page-width search-drawer__inner">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-drawer__form" data-predictive-search-form>
        <input type="hidden" name="type" value="product,article,page,collection">
        {% render 'icon', name: 'search', class: 'search-drawer__icon' %}
        <input
          type="search"
          name="q"
          class="search-drawer__input"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          aria-label="{{ 'general.search.search' | t }}"
          data-predictive-search-input
          value="{{ search.terms }}"
        >
        <button type="button" class="search-drawer__clear" data-search-clear aria-label="{{ 'general.search.clear' | t }}" hidden>
          {% render 'icon', name: 'close' %}
        </button>
        <button type="button" class="button--icon search-drawer__close" data-search-close aria-label="{{ 'general.accessibility.close' | t }}">
          {% render 'icon', name: 'close' %}
        </button>
      </form>

      <div class="search-drawer__results" data-predictive-search-results aria-live="polite">
        <p class="search-drawer__hint">{{ 'general.search.hint' | t }}</p>
      </div>
    </div>
  </div>
</predictive-search>
