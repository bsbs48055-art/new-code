{%- comment -%}
  Renders a breadcrumb trail. Accepts optional context objects; falls back
  to inferring the trail from the current template/request.
  Accepts:
    product: {Product} optional
    collection: {Collection} optional
    article: {Article} optional
    blog: {Blog} optional
{%- endcomment -%}
<nav class="breadcrumbs" aria-label="{{ 'general.accessibility.breadcrumbs' | t }}">
  <ol class="breadcrumbs__list">
    <li class="breadcrumbs__item">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
    </li>
    {%- if product -%}
      {%- if collection -%}
        <li class="breadcrumbs__item">
          <a href="{{ collection.url }}">{{ collection.title }}</a>
        </li>
      {%- elsif product.collections.first -%}
        <li class="breadcrumbs__item">
          <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        </li>
      {%- endif -%}
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">{{ product.title }}</li>
    {%- elsif collection -%}
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">{{ collection.title }}</li>
    {%- elsif article -%}
      <li class="breadcrumbs__item">
        <a href="{{ blog.url }}">{{ blog.title }}</a>
      </li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">{{ article.title }}</li>
    {%- elsif blog -%}
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">{{ blog.title }}</li>
    {%- elsif page -%}
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">{{ page.title }}</li>
    {%- endif -%}
  </ol>
</nav>
