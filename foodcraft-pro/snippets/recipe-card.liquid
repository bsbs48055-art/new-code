{%- comment -%}
  Renders a recipe/article preview card.
  Accepts:
    article: {Article} required
{%- endcomment -%}
<article class="recipe-card">
  <a href="{{ article.url }}" class="recipe-card__media aspect-ratio aspect-ratio--portrait rounded">
    {%- if article.image -%}
      <img
        src="{{ article.image | image_url: width: 600 }}"
        srcset="{{ article.image | image_url: width: 300 }} 300w, {{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 900 }} 900w"
        sizes="(min-width: 990px) 25vw, 50vw"
        alt="{{ article.image.alt | default: article.title | escape }}"
        width="{{ article.image.width }}"
        height="{{ article.image.height }}"
        loading="lazy"
      >
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    {%- if article.tags.size > 0 -%}
      <span class="badge recipe-card__tag">{{ article.tags.first }}</span>
    {%- endif -%}
  </a>
  <div class="recipe-card__info">
    {% render 'recipe-meta', article: article, compact: true %}
    <h3 class="recipe-card__title">
      <a href="{{ article.url }}">{{ article.title }}</a>
    </h3>
    <p class="recipe-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 16 }}</p>
    <a href="{{ article.url }}" class="link recipe-card__link">
      {{ 'blog.article.view_recipe' | t }}
      {% render 'icon', name: 'arrow-right' %}
    </a>
  </div>
</article>
