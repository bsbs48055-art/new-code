{
  "manifest_version": 3,
  "name": "Content Hunter AI Pro",
  "short_name": "Content Hunter",
  "version": "1.0.0",
  "description": "AI-powered content research for creators — trending topics, keywords, hashtags, and opportunities via official APIs.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Content Hunter AI Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:8787 https://* data: blob:;"
  },
  "minimum_chrome_version": "116"
}
