{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "44rem",
			"wideSize": "68rem"
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "name": "Warm White", "slug": "warm-white", "color": "#fdfbf7" },
				{ "name": "Cream", "slug": "cream", "color": "#f7f1e7" },
				{ "name": "Beige", "slug": "beige", "color": "#ebe1d3" },
				{ "name": "Taupe", "slug": "taupe", "color": "#6e6357" },
				{ "name": "Charcoal", "slug": "charcoal", "color": "#23211e" },
				{ "name": "Clay Accent", "slug": "accent", "color": "#9c5b39" },
				{ "name": "White", "slug": "white", "color": "#ffffff" }
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Editorial Serif",
					"slug": "display",
					"fontFamily": "Fraunces, \"Iowan Old Style\", Georgia, \"Times New Roman\", serif"
				},
				{
					"name": "Text Sans",
					"slug": "body",
					"fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "name": "Small", "slug": "small", "size": "0.875rem" },
				{ "name": "Medium", "slug": "medium", "size": "1.0625rem" },
				{ "name": "Large", "slug": "large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.3125rem" } },
				{ "name": "Extra Large", "slug": "x-large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "name": "Huge", "slug": "xx-large", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "name": "Tight", "slug": "20", "size": "0.75rem" },
				{ "name": "Small", "slug": "30", "size": "1.25rem" },
				{ "name": "Medium", "slug": "40", "size": "2rem" },
				{ "name": "Large", "slug": "50", "size": "3rem" },
				{ "name": "Extra Large", "slug": "60", "size": "4.5rem" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--warm-white)",
			"text": "var(--wp--preset--color--charcoal)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.75"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				":hover": { "typography": { "textDecoration": "underline" } }
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.25"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600"
				}
			}
		},
		"blocks": {
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			}
		}
	},
	"templateParts": [],
	"customTemplates": []
}
