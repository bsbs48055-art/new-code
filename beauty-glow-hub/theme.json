{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1040px"
		},
		"color": {
			"custom": true,
			"customGradient": true,
			"defaultPalette": false,
			"palette": [
				{ "slug": "primary", "color": "#E91E63", "name": "Primary Pink" },
				{ "slug": "secondary", "color": "#F8BBD0", "name": "Soft Pink" },
				{ "slug": "accent", "color": "#D4AF37", "name": "Gold Accent" },
				{ "slug": "text", "color": "#333333", "name": "Ink" },
				{ "slug": "light", "color": "#FFF8FB", "name": "Light Background" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" }
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"slug": "body",
					"name": "Inter"
				},
				{
					"fontFamily": "\"Playfair Display\", Georgia, \"Times New Roman\", serif",
					"slug": "heading",
					"name": "Playfair Display"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem", "name": "Small" },
				{ "slug": "medium", "size": "1.0625rem", "name": "Medium" },
				{ "slug": "large", "size": "1.35rem", "name": "Large" },
				{ "slug": "x-large", "size": "2rem", "name": "Extra Large" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "#FFFFFF",
			"text": "#333333"
		},
		"typography": {
			"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
			"fontSize": "1.0625rem",
			"lineHeight": "1.75"
		},
		"elements": {
			"link": {
				"color": { "text": "#E91E63" }
			},
			"h1": { "typography": { "fontFamily": "\"Playfair Display\", Georgia, serif" } },
			"h2": { "typography": { "fontFamily": "\"Playfair Display\", Georgia, serif" } },
			"h3": { "typography": { "fontFamily": "\"Playfair Display\", Georgia, serif" } },
			"h4": { "typography": { "fontFamily": "\"Playfair Display\", Georgia, serif" } }
		}
	}
}
