# Copy this file to `.env` in the same folder and fill in your own values.
# Never commit your real .env file — it contains confidential app secrets.

PORT=8787

# From Facebook Developer Console → your app → Settings → Basic.
FACEBOOK_APP_SECRET=

# From the TikTok Developer Portal → your app → Basic Information.
TIKTOK_CLIENT_SECRET=

# Comma-separated list of allowed CORS origins. A packed/unpacked Chrome
# extension's origin looks like: chrome-extension://<your-extension-id>
ALLOWED_ORIGINS=
